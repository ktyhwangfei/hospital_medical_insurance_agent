# ============================================
# 生产环境配置 (Production Environment)
# ============================================
# 警告: 此文件包含敏感配置，请勿提交到版本控制系统
# 请使用环境变量或密钥管理服务覆盖以下默认值
# ============================================

# ---------- 数据库配置 ----------
DATABASE_URL=postgresql://postgres:123456@postgres:5432/hospital_mcp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REDACTED
POSTGRES_DB=hospital_mcp
POSTGRES_MIN_CONNECTIONS=5
POSTGRES_MAX_CONNECTIONS=50

# ---------- Redis配置 ----------
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# ---------- Milvus配置 ----------
MILVUS_URI=http://milvus:19530
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ---------- 模型服务配置 ----------
MODEL_API_KEY=your-api-key-here
MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_API_KEY= 和 MODEL_BASE_URL= 请通过安全渠道获取

# ---------- 日志配置 ----------
LOG_LEVEL=WARNING
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ---------- 认证与安全 ----------
AUTH_SECRET_KEY=change-this-to-a-secure-random-key
# 生产环境请使用强随机密钥: python -c "import secrets; print(secrets.token_hex(32))"

# ---------- CORS配置 ----------
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# ---------- 技能存储 ----------
SKILLS_DIR=/app/skills
