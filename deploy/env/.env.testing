# ============================================
# 测试环境配置 (Testing Environment)
# ============================================

# ---------- 数据库配置 ----------
DATABASE_URL=postgresql://postgres:123456@localhost:5432/hospital_mcp_test
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REDACTED
POSTGRES_DB=hospital_mcp_test
POSTGRES_MIN_CONNECTIONS=1
POSTGRES_MAX_CONNECTIONS=5

# ---------- Redis配置 ----------
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_MAX_CONNECTIONS=5

# ---------- Milvus配置 ----------
MILVUS_URI=tcp://127.0.0.1:19121
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19121

# ---------- 模型服务配置 ----------
MODEL_API_KEY=sk-test-key
MODEL_BASE_URL=https://api.openai.com/v1

# ---------- 日志配置 ----------
LOG_LEVEL=DEBUG
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ---------- 认证与安全 ----------
AUTH_SECRET_KEY=test-secret-key

# ---------- 测试模式配置 ----------
USE_MEMORY_STORAGE=1
TESTING=true
