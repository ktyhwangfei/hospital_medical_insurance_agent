 "pay_type_doc151": [
  [
   "支付方式编码",
   "支付方式类型",
   "支付方式模式",
   "支付类型说明"
  ],
  [
   "A01",
   "个人待遇结算",
   "按病种定额",
   "对治疗方式比较单一的病种设定费用定额，定额内个人与基金按比例分担费用。部分地方门诊特殊病、门诊慢性病和单病种包干采用此支付方式。"
  ],
  [
   "A02",
   "个人待遇结算",
   "通道式",
   "按设定基金支付顺序进行个人待遇支付计算，比如有些地方要求先使用个人账户，再使用统筹基金。"
  ],
  [
   "A03",
   "个人待遇结算",
   "板块式",
   "根据费用发生额按顺序分段计算个人待遇基金支付金额。"
  ],
  [
   "B01",
   "医保支付",
   "按项目支付",
   "按实际发生的基金垫付金额支付费用。"
  ],
  [
   "B02",
   "医保支付",
   "按人头支付",
   "在一个治疗周期内（年），按费用定额和人数（支付费用=定额*人数）计算支付金额。"
  ],
  [
   "B03",
   "医保支付",
   "按床日支付",
   "对于精神病、安宁疗护、医疗康复等需要长期住院治疗且日均费用较稳定的疾病根据床日数进行费用支付。"
  ],
  [
   "B04",
