        <mxCell id="nl9lndQDQIbHQGJPI27v-14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;flipV=0;legacyAnchorPoints=0;fontStyle=0" value="SaaS 应用产品层&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;font style=&quot;color: light-dark(rgb(5, 5, 5), rgb(43, 6, 255));&quot;&gt;统一交互门户（支持统一门户和嵌入式两种形态）&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;color: light-dark(rgb(3, 3, 3), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;box-sizing: border-box; border: 0px solid; padding: 0px; font-size: 13px; text-align: start; white-space-collapse: preserve;&quot;&gt;在保留既有业务系统边界基础上，提供统一智能入口、自然语言交互、智能导办和跨系统协同能力&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="660" x="531" y="70" as="geometry" />
        </mxCell>
        <mxCell id="nl9lndQDQIbHQGJPI27v-15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;flipV=0;legacyAnchorPoints=0;fontStyle=0" value="Paas平台支撑层&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;通用平台能力：统一接入网关、注册、配置中心、消息队列、日志监控、认证鉴权&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(5, 5, 5), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;&quot;&gt;规划与执行能力：统一交互API、&lt;span style=&quot;font-size: 0.95em; text-align: start;&quot;&gt;&lt;font&gt;意图识别、任务规划、编排执行引擎、会话与上下文管理、能力调度、结果生成与响应控制&lt;/font&gt;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(5, 5, 5), rgb(237, 237, 237));&quot;&gt;&lt;span&gt;模型服务能力：模型网关、vLLM推理服务、大模型、&lt;code style=&quot;background-color: transparent;&quot;&gt;Embedding&lt;/code&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; 模型、&lt;/span&gt;&lt;code style=&quot;background-color: transparent;&quot;&gt;Rerank&lt;/code&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; 模型、 OCR 模型、语音模型&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(5, 5, 5), rgb(237, 237, 237));&quot;&gt;&lt;span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;知识与扩展能力：&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Skill管理、Tools注册与调度、MCP接入、A2A接入、&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;业务系统适配器、&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(5, 5, 5), rgb(168, 194, 255));&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;知识&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;服务&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
