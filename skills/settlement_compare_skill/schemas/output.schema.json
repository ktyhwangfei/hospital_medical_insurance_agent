{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital-ai/schemas/settlement-compare/output.schema.json",
  "title": "Skill Output Schema",
  "description": "settlement-compare skill 的标准输出结构。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_id", "baseline_settlement_id", "can_answer",
    "answer", "diff_items", "attributions", "warnings"
  ],
  "properties": {
    "skill_id": {
      "type": "string",
      "const": "settlement-compare"
    },
    "settlement_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "参与对比的全部结算单号"
    },
    "baseline_settlement_id": {
      "type": "string",
      "description": "基准结算单号（列表第一张）"
    },
    "target_fee_item": {
      "type": ["string", "null"],
      "description": "指定的对比费用项；null 表示全项对比"
    },
    "can_answer": {
      "type": "boolean",
      "description": "是否有足够数据回答对比问题"
    },
    "partial_answer": {
      "type": "boolean",
      "description": "是否仅能部分回答（存在未命中归因规则的差异）"
    },
    "diff_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/DiffItem" },
      "description": "逐项字段差异列表"
    },
    "attributions": {
      "type": "array",
      "items": { "$ref": "attribution.schema.json" },
      "description": "逐项归因结果"
    },
    "policy_evidence": {
      "type": "array",
      "items": { "type": "object" },
      "description": "归因政策证据列表"
    },
    "policy_status": {
      "type": "string"
    },
    "policy_status_message": {
      "type": "string"
    },
    "answer": {
      "type": "string",
      "description": "模板化对比解释（逐项差异 + 归因 + citations）"
    },
    "calculation_trace": {
      "type": "object",
      "description": "diff 计算链路（结构化 diff_items/attributions 的机器可读形式）"
    },
    "definition": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "DiffItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "label", "settlement_id", "baseline_value", "current_value"],
      "properties": {
        "field": { "type": "string", "description": "结算字段名" },
        "label": { "type": "string", "description": "字段中文名" },
        "settlement_id": { "type": "string", "description": "对比结算单号" },
        "baseline_value": { "type": ["number", "string", "null"] },
        "current_value": { "type": ["number", "string", "null"] },
        "delta": { "type": ["number", "null"], "description": "数值差值（current - baseline）" },
        "delta_ratio": { "type": ["number", "null"], "description": "相对基准的比值（current / baseline）" }
      }
    }
  }
}
